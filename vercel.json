{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path((?:.*/)?[^/]+)\\.html",
      "destination": "/:path",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "demo.mokshbudhiraja.com"
        }
      ],
      "destination": "/demos",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>(?!www\\.|demo\\.)[a-z0-9-]+)\\.mokshbudhiraja\\.com"
        }
      ],
      "destination": "/demos/:sub",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!demos/).*)",
      "has": [
        {
          "type": "host",
          "value": "(?!www\\.)[a-z0-9-]+\\.mokshbudhiraja\\.com"
        }
      ],
      "destination": "/demos/:path"
    }
  ]
}
